<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nominaguate.controller.RegistroController">

    <VBox spacing="10" maxWidth="340" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 8;">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="NominaGuate" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label text="Crear nueva cuenta" style="-fx-text-fill: gray;"/>

        <Label text="Nombre completo" style="-fx-font-size: 12px;"/>
        <TextField fx:id="txtNombreCompleto" promptText="Nombre y apellidos"/>

        <Label text="Usuario" style="-fx-font-size: 12px;"/>
        <TextField fx:id="txtUsuario" promptText="nombre.usuario"/>

        <Label text="Contraseña" style="-fx-font-size: 12px;"/>
        <PasswordField fx:id="txtPassword" promptText="Contraseña"/>

        <Label text="Confirmar contraseña" style="-fx-font-size: 12px;"/>
        <PasswordField fx:id="txtConfirmarPassword" promptText="Repite la contraseña"/>

        <Label text="Rol" style="-fx-font-size: 12px;"/>
        <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Selecciona un rol"/>

        <Label fx:id="lblMensaje" style="-fx-text-fill: #c0392b;" visible="false" managed="false" wrapText="true"/>

        <ProgressIndicator fx:id="progresoRegistro" visible="false" prefWidth="24" prefHeight="24"/>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnRegistrar" text="Registrar" onAction="#handleRegistrar"
                    maxWidth="Infinity" defaultButton="true" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar"
                    maxWidth="Infinity" cancelButton="true" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

</StackPane>
