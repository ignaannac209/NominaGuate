<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nominaguate.controller.AsistenciaController">
    <children>
        <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Label text="Control de Asistencia" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <VBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="ID de Empleado:" textFill="#333333">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtEmpleadoId" promptText="Ingrese código del empleado" style="-fx-pref-height: 35;" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button onAction="#handleMarcarEntrada" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35; -fx-pref-width: 140; -fx-cursor: hand;" text="Marcar Entrada" />
                        <Button onAction="#handleMarcarSalida" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35; -fx-pref-width: 140; -fx-cursor: hand;" text="Marcar Salida" />
                    </children>
                </HBox>

                <Button onAction="#handleVolver" style="-fx-background-color: #bdc3c7; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-pref-height: 35; -fx-pref-width: 120; -fx-cursor: hand;" text="Volver" />
            </children>
        </VBox>
    </children>
</VBox>