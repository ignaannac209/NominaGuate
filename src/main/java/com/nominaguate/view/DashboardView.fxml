<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nominaguate.controller.DashboardController">

    <top>
        <VBox spacing="12">
            <padding>
                <Insets bottom="0" left="12" right="12" top="12" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Dashboard Gerencial" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label text="Periodo:" />
                <ComboBox fx:id="cmbFiltroPeriodo" onAction="#onFiltrarPeriodo" prefWidth="220" promptText="Todos" />
                <Button onAction="#onLimpiarFiltro" text="Limpiar filtro" />
            </HBox>
         <Button mnemonicParsing="false" onAction="#handleAbrirAsistencia" text="Control Asistencia" />

            <!-- Tarjetas de KPIs -->
            <GridPane hgap="10" style="-fx-background-color: #f4f4f4; -fx-background-radius: 6; -fx-padding: 12;" vgap="4">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                </columnConstraints>

                <Label style="-fx-text-fill: gray;" text="Planillas" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label style="-fx-text-fill: gray;" text="Total devengado" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label style="-fx-text-fill: gray;" text="Total descuentos" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label style="-fx-text-fill: gray;" text="Total neto" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Label style="-fx-text-fill: gray;" text="Promedio neto" GridPane.columnIndex="4" GridPane.rowIndex="0" />

                <Label fx:id="lblTotalPlanillas" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lblTotalDevengado" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Q 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="lblTotalDescuentos" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Q 0.00" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="lblTotalNeto" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="Q 0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label fx:id="lblPromedioNeto" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Q 0.00" GridPane.columnIndex="4" GridPane.rowIndex="1" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="12" left="12" right="12" top="12" />
            </padding>

            <BarChart fx:id="chartPorDepartamento" legendVisible="false" prefHeight="260" title="Total neto pagado por departamento">
                <xAxis>
                    <CategoryAxis label="Departamento" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Monto (Q)" />
                </yAxis>
            </BarChart>

            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Planillas generadas" />

            <TableView fx:id="tblPlanillas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPlanilla" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colPeriodo" prefWidth="160" text="Periodo" />
                    <TableColumn fx:id="colFecha" prefWidth="140" text="Fecha generación" />
                    <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                    <TableColumn fx:id="colCantidadEmpleados" prefWidth="90" text="Empleados" />
                    <TableColumn fx:id="colTotalNeto" prefWidth="120" text="Total Neto" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
