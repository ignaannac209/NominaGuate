<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nominaguate.controller.DashboardController"
            stylesheets="@theme-lv.css">

    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="0" left="12"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Dashboard Gerencial" styleClass="titulo-principal"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="Periodo:" styleClass="label-normal"/>
                <ComboBox fx:id="cmbFiltroPeriodo" onAction="#onFiltrarPeriodo" prefWidth="220" promptText="Todos"/>
                <Button text="Limpiar filtro" onAction="#onLimpiarFiltro" styleClass="boton-secundario"/>
                <Button text="Empleados" onAction="#onAbrirEmpleados"/>
            </HBox>

            <!-- Tarjetas de KPIs -->
            <GridPane hgap="10" vgap="4" styleClass="panel-tarjeta">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                </columnConstraints>

                <Label text="Planillas" styleClass="label-tenue" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Total devengado" styleClass="label-tenue" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Total descuentos" styleClass="label-tenue" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label text="Total neto" styleClass="label-tenue" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Promedio neto" styleClass="label-tenue" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                <Label fx:id="lblTotalPlanillas" text="0" styleClass="valor-destacado" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblTotalDevengado" text="Q 0.00" styleClass="valor-destacado" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label fx:id="lblTotalDescuentos" text="Q 0.00" styleClass="valor-destacado" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="lblTotalNeto" text="Q 0.00" styleClass="valor-destacado-dorado" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <Label fx:id="lblPromedioNeto" text="Q 0.00" styleClass="valor-destacado" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <BarChart fx:id="chartPorDepartamento" title="Total neto pagado por departamento" prefHeight="260" legendVisible="false">
                <xAxis>
                    <CategoryAxis label="Departamento"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Monto (Q)"/>
                </yAxis>
            </BarChart>

            <Label text="Planillas generadas" styleClass="subtitulo"/>

            <TableView fx:id="tblPlanillas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPlanilla" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colPeriodo" text="Periodo" prefWidth="160"/>
                    <TableColumn fx:id="colFecha" text="Fecha generación" prefWidth="140"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    <TableColumn fx:id="colCantidadEmpleados" text="Empleados" prefWidth="90"/>
                    <TableColumn fx:id="colTotalNeto" text="Total Neto" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane> 