<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="1000.0" spacing="20.0"
     stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nominaguate.controller.AsistenciaController">
    <children>
        <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" styleClass="card">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Label text="Control de Asistencia" styleClass="app-title" />

                <VBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="ID de Empleado:" styleClass="field-label" />
                        <TextField fx:id="txtEmpleadoId" promptText="Ingrese código del empleado" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button onAction="#handleMarcarEntrada" prefHeight="35" prefWidth="140" text="Marcar Entrada" styleClass="btn-success" />
                        <Button onAction="#handleMarcarSalida" prefHeight="35" prefWidth="140" text="Marcar Salida" styleClass="btn-danger" />
                    </children>
                </HBox>

                <Button onAction="#handleVolver" prefHeight="35" prefWidth="120" text="Volver" styleClass="btn-secondary" />
            </children>
        </VBox>
    </children>
</VBox>