<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@../css/styles.css"
            fx:controller="com.nominaguate.controller.DashboardController">

    <top>
        <VBox spacing="14">
            <padding>
                <Insets bottom="0" left="16" right="16" top="16" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Dashboard Gerencial" styleClass="app-title" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label text="Periodo:" styleClass="field-label" />
                <ComboBox fx:id="cmbFiltroPeriodo" onAction="#onFiltrarPeriodo" prefWidth="220" promptText="Todos" />
                <Button onAction="#onLimpiarFiltro" text="Limpiar filtro" styleClass="btn-secondary" />
                <Button mnemonicParsing="false" onAction="#handleAbrirAsistencia" text="Control Asistencia" styleClass="btn-primary" />
            </HBox>

            <!-- Tarjetas de KPIs -->
            <GridPane hgap="14" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                </columnConstraints>

                <VBox styleClass="kpi-box" GridPane.columnIndex="0">
                    <Label text="Planillas" styleClass="kpi-caption" />
                    <Label fx:id="lblTotalPlanillas" text="0" styleClass="kpi-value" />
                </VBox>

                <VBox styleClass="kpi-box" GridPane.columnIndex="1">
                    <Label text="Total devengado" styleClass="kpi-caption" />
                    <Label fx:id="lblTotalDevengado" text="Q 0.00" styleClass="kpi-value" />
                </VBox>

                <VBox styleClass="kpi-box" GridPane.columnIndex="2">
                    <Label text="Total descuentos" styleClass="kpi-caption" />
                    <Label fx:id="lblTotalDescuentos" text="Q 0.00" styleClass="kpi-value" />
                </VBox>

                <VBox styleClass="kpi-box" GridPane.columnIndex="3">
                    <Label text="Total neto" styleClass="kpi-caption" />
                    <Label fx:id="lblTotalNeto" text="Q 0.00" styleClass="kpi-value-accent" />
                </VBox>

                <VBox styleClass="kpi-box" GridPane.columnIndex="4">
                    <Label text="Promedio neto" styleClass="kpi-caption" />
                    <Label fx:id="lblPromedioNeto" text="Q 0.00" styleClass="kpi-value" />
                </VBox>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="card">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
            <BorderPane.margin>
                <Insets bottom="16" left="16" right="16" top="10" />
            </BorderPane.margin>

            <BarChart fx:id="chartPorDepartamento" legendVisible="false" prefHeight="260" title="Total neto pagado por departamento">
                <xAxis>
                    <CategoryAxis label="Departamento" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Monto (Q)" />
                </yAxis>
            </BarChart>

            <Label text="Planillas generadas" styleClass="section-title" />

            <TableView fx:id="tblPlanillas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPlanilla" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colPeriodo" prefWidth="160" text="Periodo" />
                    <TableColumn fx:id="colFecha" prefWidth="140" text="Fecha generación" />
                    <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                    <TableColumn fx:id="colCantidadEmpleados" prefWidth="90" text="Empleados" />
                    <TableColumn fx:id="colTotalNeto" prefWidth="120" text="Total Neto" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>