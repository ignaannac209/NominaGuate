<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
          stylesheets="@../css/styles.css"
           fx:controller="com.nominaguate.controller.RegistroController">

    <VBox spacing="10" maxWidth="340" alignment="CENTER" styleClass="card">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="NominaGuate" styleClass="app-title"/>
        <Label text="Crear nueva cuenta" styleClass="app-subtitle"/>

        <Label text="Nombre completo" styleClass="field-label"/>
        <TextField fx:id="txtNombreCompleto" promptText="Nombre y apellidos"/>

        <Label text="Usuario" styleClass="field-label"/>
        <TextField fx:id="txtUsuario" promptText="nombre.usuario"/>

        <Label text="Contraseña" styleClass="field-label"/>
        <PasswordField fx:id="txtPassword" promptText="Contraseña"/>

        <Label text="Confirmar contraseña" styleClass="field-label"/>
        <PasswordField fx:id="txtConfirmarPassword" promptText="Repite la contraseña"/>

        <Label text="Rol" styleClass="field-label"/>
        <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Selecciona un rol"/>

        <Label fx:id="lblMensaje" styleClass="error-label" visible="false" managed="false" wrapText="true"/>

        <ProgressIndicator fx:id="progresoRegistro" visible="false" prefWidth="24" prefHeight="24"/>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnRegistrar" text="Registrar" onAction="#handleRegistrar"
                    maxWidth="Infinity" defaultButton="true" HBox.hgrow="ALWAYS" styleClass="btn-primary"/>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar"
                    maxWidth="Infinity" cancelButton="true" HBox.hgrow="ALWAYS" styleClass="btn-secondary"/>
        </HBox>
    </VBox>

</StackPane>